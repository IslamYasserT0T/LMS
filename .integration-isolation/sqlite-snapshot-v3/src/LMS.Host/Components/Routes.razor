@using LMS.Host.Components.Layout
@using LMS.Host.Contracts
@using LMS.Host.Services
@inherits LayoutComponentBase
@inject IModuleManager ModuleManager

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="ModuleManager.GetModules().Select(m => m.Assembly).Concat(ModuleManager.GetAdditionalBlazorAssemblies()).Distinct().ToArray()">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="container">
                <h1>Page Not Found</h1>
                <p>Sorry, there's nothing at this address.</p>
                <a href="/" class="btn btn-primary">Return to Home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override Task OnInitializedAsync()
    {
        var modules = ModuleManager.GetModules();
        return base.OnInitializedAsync();
    }
}
