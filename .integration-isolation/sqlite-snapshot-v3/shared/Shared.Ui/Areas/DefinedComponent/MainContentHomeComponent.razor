@using MudBlazor

<MudCard Style="position: relative; overflow: hidden; border-radius: 12px; width: 100%;">
    <MudCardMedia Image="@ImageUrl"
                  Height="250"
                  Style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;" />

    <MudCardContent Class="d-flex flex-column justify-center align-end text-white p-5"
                    Style="position: relative; z-index: 2; height: 300px; text-align: right; ">

        <MudText Typo="Typo.h4" Class="fw-bold mb-4" Style="@($"color: {(TextColor == "white" ? "white" : "black")};")">@Headline</MudText>
        <MudText Typo="Typo.subtitle2"
                 Class="mb-4"
                 Style="@($"max-width: 300px; line-height: 1.5; color: {(TextColor == "white" ? "white" : "black")};")">
            @Paragraph
        </MudText> 

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="OnButtonClick">
            @ButtonText
        </MudButton>
    </MudCardContent>
</MudCard>

