@using MudBlazor
@typeparam TItem

<MudDataGrid T="TItem"
             @ref="GridRef"
             ServerData="ServerData"
             SortMode="SortMode.Multiple"
             Hideable="true"
             Loading
             ShowColumnOptions>
    <ToolBarContent>
        <MudItem Class="d-flex justify-content-between align-items-end" md="12">
            <MudItem xs="12" sm="3">
                <MudText Typo="Typo.h6">@Title</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value:get="_searchString" @bind-Value:set="OnSearchChanged"
                              Placeholder="Search"
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Outlined"
                              Style="height: 35px;" />
            </MudItem>

            <MudItem xs="12" sm="3" Class="align-self-end">
                @if (CreateCallback.HasDelegate )
                {
                    <MudButton Class="mx-2" OnClick="CreateCallback" Color="Color.Primary" Variant="Variant.Filled">
                        Create
                    </MudButton>
                }
            </MudItem>
        </MudItem>
    </ToolBarContent>

    <Columns>
        @Columns
        @if (ActionsTemplate is not null)
        {
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    @ActionsTemplate(@context.Item)
                </CellTemplate>
            </TemplateColumn>
        }
    </Columns>

    <PagerContent>
        <MudDataGridPager T="TItem" />
    </PagerContent>
</MudDataGrid>

