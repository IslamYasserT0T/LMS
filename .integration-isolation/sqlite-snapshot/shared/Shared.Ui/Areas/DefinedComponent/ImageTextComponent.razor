@using MudBlazor

<MudGrid Class="mt-2">
    <MudPaper Class="rounded-4 overflow-hidden p-0" Elevation="1">
        <MudImage Src="@ImageUrl"
                  Alt="@AltText"
                  Style="width: 100%; height: auto; display: block;" />

        <MudItem Class="p-4">
            <MudText Typo="Typo.h5" Style="font-size:1.6rem" Class="fw-bold mb-0 text-center">@Title</MudText>
        </MudItem>
    </MudPaper>
</MudGrid>

