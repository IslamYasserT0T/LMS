        box-shadow: -1px -1px 1.9px 0px #839CED26 inset;
    }
    .mud-table-root .mud-table-head  {
        color: var(--mud-palette-text-primary);
        font-weight: 500;
        line-height: 1.5rem;
        border-radius:10px;
        background-color: #FDFDFD;
    }
            /* Remove inner borders */
            .outer-bordered-table table thead,
            .outer-bordered-table table tbody,
            .outer-bordered-table table tr,
            .outer-bordered-table table td,
            .outer-bordered-table table th {
                border: none !important;
            }

</style>