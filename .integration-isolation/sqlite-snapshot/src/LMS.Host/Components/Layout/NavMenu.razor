@code
{
    private IEnumerable<ModuleInfo> Modules;
    private Dictionary<string, SettingDefinition> Settings = new();
    protected override async Task OnInitializedAsync()
    {
        Modules = ModuleManager.GetUiModules();
        Settings = await settingDefination.InitializeAsync();
        StateHasChanged();
    }
    private async Task SettingChanged(bool isEnabled, KeyValuePair<string, SettingDefinition> setting)
    {
        setting.Value.IsEnabled = isEnabled;
        await settingDefination.Update(setting.Value);
        Settings = await settingDefination.InitializeAsync();
        StateHasChanged();

    }
    private async void OnModulesChanged(IEnumerable<ModuleInfo> modules)
    {
        await InvokeAsync(() =>
        {
            Modules = modules;
            StateHasChanged();
        });
    }
}
