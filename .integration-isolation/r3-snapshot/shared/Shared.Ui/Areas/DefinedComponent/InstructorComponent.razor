@using MudBlazor

<MudPaper Class="d-flex flex-column align-center"
          Style="width: 200px; text-align: center;"
          Elevation="0">

    <MudPaper Class="position-relative"
              Style="width: 100%; overflow: hidden; position: relative;"
              Elevation="0">

        <MudImage Src="@ImageUrl"
                  Alt="@FullName"
                  Style="width: 100%; height: 100%; object-fit: contain; position: relative; z-index: 1;" />

        <MudPaper Style="
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 80px;
            background-color: #0056b3;
            border-bottom-left-radius: 24px;
            border-bottom-right-radius: 24px;
            z-index: 0;"
                  Elevation="0" />
    </MudPaper>

    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="fw-bold mt-2">@FullName</MudText>
    <MudText Typo="Typo.caption" Align="Align.Center">@Email</MudText>
</MudPaper>

