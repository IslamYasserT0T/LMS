@using MudBlazor
@typeparam TItem

<MudPaper Class="p-3" Style="box-sizing:border-box;background-color:transparent" Elevation="0">
    <MudGrid Justify="Justify.SpaceAround" Spacing="4">
        @foreach (var item in PagedItems)
        {
            <MudItem xs="12" sm="6" md="2">
                @ItemTemplate(item)
            </MudItem>
        }
    </MudGrid>

    <div class="d-flex justify-end align-end mt-4 gap-3">
        <MudButton Size="Size.Small"
                   Style="background-color:#192A56; color:white;"
                   Variant="Variant.Filled"
                   Disabled="@(_currentPage == 1)"
                   OnClick="PrevPage">
            ◀
        </MudButton>
        <MudButton Size="Size.Small"
                   Style="background-color:#192A56; color:white;"
                   Variant="Variant.Filled"
                   Disabled="@(_currentPage == _totalPages)"
                   OnClick="NextPage">
            ▶
        </MudButton>
    </div>

    <div class="d-flex justify-start align-start mt-4 gap-2">
        @for (int i = 1; i <= _totalPages; i++)
        {
            <div style="width: 10px; height: 10px; border-radius: 50%; background-color:@(i == _currentPage ? "#192A56" : "#cfd8dc");"></div>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public List<TItem> Items { get; set; }
    [Parameter] public RenderFragment<TItem> ItemTemplate { get; set; }

    [Parameter] public int PageSize { get; set; } = 4;

    private int _currentPage = 1;
    private int _totalPages => (int)Math.Ceiling((double)(Items?.Count ?? 0) / PageSize);

    private IEnumerable<TItem> PagedItems => Items?
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize);

    private void PrevPage()
    {
        if (_currentPage > 1)
            _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < _totalPages)
            _currentPage++;
    }
}
