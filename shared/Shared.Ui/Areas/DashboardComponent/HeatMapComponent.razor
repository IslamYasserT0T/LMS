    <MudItem xs="12" sm="6">
        <MudPaper Class="p-4" Style="background-color:transparent;box-shadow:none;">
           <MudText style="font-size:14px" Class="mb-5" Align="MudBlazor.Align.Right">الكمية</MudText>
            <div style="
                height: 10px;
                margin-bottom: 0.5rem;
                background: linear-gradient(to right, #004e92, #0074d9, #00c3ff, #7ed6df, #dff9fb);
">
            </div>

            <div style="
                        display: flex;
                        justify-content: space-between;
                        font-size: 14px;
                        color: #333;
                        direction: rtl;
">
                <span>1</span>
                <span>20</span>
                <span>40</span>
                <span>60</span>
                <span>80</span>
                <span>100</span>
            </div>

            <ApexChart TItem="RegionIncident"
                       Options="options">

                @foreach (var regionGroup in incidents.GroupBy(e => e.Region))
                {
                    <ApexPointSeries TItem="RegionIncident"
                                     Items="regionGroup.OrderBy(e => e.Year)"
                                     Name="@regionGroup.Key"
                                     SeriesType="SeriesType.Heatmap"
                                     XValue="e => e.Year.ToString()"
                                     YAggregate="@(e => (int)e.Average(a => a.Severity))" />
                }

            </ApexChart>

        </MudPaper>
    </MudItem>
</MudGrid>
