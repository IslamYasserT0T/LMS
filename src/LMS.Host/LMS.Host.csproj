<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Shared.Application\Shared.Application.csproj" />
    <ProjectReference Include="..\..\shared\Shared.Core\Shared.Core.csproj" />
    <ProjectReference Include="..\..\shared\Shared.Domain\Shared.Domain.csproj" />
    <ProjectReference Include="..\..\shared\Shared.Infrastructure\Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\shared\Shared.Ui\Shared.Ui.csproj" />
  </ItemGroup>
	<Target Name="BuildPlugin" BeforeTargets="Build">
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.Domain\SampleModule.Domain.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.Domain/" />
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.Infrastructure\SampleModule.Infrastructure.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.Infrastructure/" />
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.Application\SampleModule.Application.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.Application/" />
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.Ui\SampleModule.Ui.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.Ui/" />
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.API\SampleModule.API.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.API/" />
		<MSBuild Projects="..\..\modules\SampleModule\SampleModule.Core\SampleModule.Core.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/SampleModule.Core/" />
		<!-- user management -->
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.Domain\UserManagementModule.Domain.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.Domain/" />
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.Infrastructure\UserManagementModule.Infrastructure.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.Infrastructure/" />
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.Application\UserManagementModule.Application.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.Application/" />
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.Ui\UserManagementModule.Ui.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.Ui/" />
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.API\UserManagementModule.API.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.API/" />
		<MSBuild Projects="..\..\modules\UserManagementModule\UserManagementModule.Core\UserManagementModule.Core.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(OutputPath)/plugins/UserManagementModule.Core/" />

	</Target>
</Project>
