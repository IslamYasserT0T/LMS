@using LMS.Host.Contracts
@using LMS.Host.Services
@using MudBlazor
@inherits LayoutComponentBase
@inject IModuleManager ModuleManager
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code{
    private IEnumerable<ModuleInfo> Modules;

    protected override void OnInitialized()
    {
        Modules = ModuleManager.GetUiModules();
        StateHasChanged();
    }

    private async void OnModulesChanged(IEnumerable<ModuleInfo> modules)
    {
        await InvokeAsync(() =>
        {
            Modules = modules;
            StateHasChanged();
        });
    }
}