@using LMS.Host.Contracts
@using LMS.Host.Services
@using MudBlazor
@using SettingModule.Contracts
@using SettingModule.Entities
@inject ISettingDefinationManager settingDefination
@inject IModuleManager ModuleManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LMS.Host</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">
        <MudNavGroup Title="Modules">
            @foreach (var item in ModuleManager.MenuItems)
            {
                <div class="nav-item px-3">
                    <NavLink href="@item.Url" class="nav-link">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @item.Title
                    </NavLink>
                </div>
            }
        </MudNavGroup>
      
    </nav>
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <div class="nav-link text-muted">
                <span class="oi oi-puzzle-piece" aria-hidden="true"></span> Modules
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Component/razor">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Component Razor
            </NavLink>
        </div>
        @foreach (var module in Modules)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@module.Module.URL">
                    <span class="oi oi-list-rich" aria-hidden="true"></span> @module.Module.Name
                </NavLink>
            </div>
        }
        @foreach (var module in Settings)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link">
                    <InputCheckbox Value="@module.Value.IsEnabled"
                                   ValueChanged="@(v => SettingChanged(v, module))"
                                   ValueExpression="() => module.Value.IsEnabled"
                                   class="oi oi-list-rich" />

                    <span>@module.Value.Name</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code
{
    private IEnumerable<ModuleInfo> Modules;
    private Dictionary<string, SettingDefinition> Settings = new();
    protected override async Task OnInitializedAsync()
    {
        Modules = ModuleManager.GetUiModules();
        Settings = await settingDefination.InitializeAsync();
        StateHasChanged();
    }
    private async Task SettingChanged(bool isEnabled, KeyValuePair<string, SettingDefinition> setting)
    {
        setting.Value.IsEnabled = isEnabled;
        await settingDefination.Update(setting.Value);
        Settings = await settingDefination.InitializeAsync();
        StateHasChanged();

    }
    private async void OnModulesChanged(IEnumerable<ModuleInfo> modules)
    {
        await InvokeAsync(() =>
        {
            Modules = modules;
            StateHasChanged();
        });
    }
}